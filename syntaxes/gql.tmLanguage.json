{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GQL",
  "scopeName": "source.gql",
  "fileTypes": ["gql", "geode"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#variables" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.gql",
          "match": "--.*$"
        },
        {
          "name": "comment.line.double-slash.gql",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gql",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.gql" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.gql" }
          },
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.gql",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.gql" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.gql" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.gql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.gql",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.gql" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.gql" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.gql",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.gql",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.gql",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gql",
          "match": "\\b(?i:CALL|CASE|DELETE|DETACH|ELSE|END|EXPLAIN|FILTER|FINISH|FOREACH|FROM|INSERT|JOIN|LET|LIMIT|LOAD|MATCH|MERGE|OFFSET|OTHERWISE|PROFILE|REMOVE|REPLACE|RETURN|SCAN|SELECT|SET|SHOW|SKIP|THEN|UNWIND|VALUE|VALUES|WHEN|WHERE|WITH)\\b"
        },
        {
          "name": "keyword.operator.logical.gql",
          "match": "\\b(?i:AND|CONTAINS|ENDS|EXISTS|FALSE|IN|IS|LIKE|NOT|NULL|OR|STARTS|TRUE|UNKNOWN|XOR)\\b"
        },
        {
          "name": "keyword.control.case.gql",
          "match": "\\b(?i:)\\b"
        },
        {
          "name": "keyword.other.ddl.gql",
          "match": "\\b(?i:ASSERT|CONSTRAINT|CREATE|DROP|GRAPH|INDEX|KEY|PROPERTY|REQUIRE|SCHEMA|TABLE)\\b"
        },
        {
          "name": "keyword.control.transaction.gql",
          "match": "\\b(?i:BEGIN|COMMIT|READ|REPEATABLE|ROLLBACK|START|TRANSACTION|WRITE)\\b"
        },
        {
          "name": "keyword.other.path.gql",
          "match": "\\b(?i:ACYCLIC|SHORTEST|SIMPLE|TRAIL|WALK)\\b"
        },
        {
          "name": "keyword.operator.set.gql",
          "match": "\\b(?i:EXCEPT|INTERSECT|UNION)\\b"
        },
        {
          "name": "keyword.other.gql",
          "match": "\\b(?i:AGGREGATE|ALL|ANY|AS|ASC|AVG|BINDING|BINDINGS|BY|CAST|CATALOG|CLOSE|COUNT|CSV|CURRENT|DESC|DIFFERENT|DISTINCT|DURATION|EDGES|ELEMENT|END_NODE|FIRST|FOR|GROUP|HAVING|HOME|IF|KEYS|LABELED|LABELS|LAST|LIST|LOCAL|MAX|MIN|NEXT|NO|NODE|NULLS|OF|ON|ONLY|OPTIONAL|ORDER|ORDINALITY|PATH|PATHS|PERIODIC|PROPERTIES|RECORD|RELATIONSHIPS|RESET|SESSION|START_NODE|SUM|TO|TYPE|TYPES|USE|USING|ZONE|ZONED)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.aggregate.gql",
          "match": "\\b(?i:count|sum|avg|min|max|collect)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.scalar.gql",
          "match": "\\b(?i:head|last|tail|reverse|range|toInteger|toFloat|toString|toBoolean|id|type|labels|properties|keys|nodes|relationships|shortestPath|allShortestPaths|indegree|outdegree)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.math.gql",
          "match": "\\b(?i:abs|ceil|floor|round|sqrt|rand|sign|exp|log|log10|sin|cos|tan|asin|acos|atan|atan2|pi|e|degrees|radians)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.string.gql",
          "match": "\\b(?i:size|length|substring|replace|toLower|toUpper|trim|lTrim|rTrim|left|right|split|startsWith|endsWith|contains)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.temporal.gql",
          "match": "\\b(?i:timestamp|date|time|datetime|duration)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.vector.gql",
          "match": "\\b(?i:vectorf32|vectori32|vector_l2|vector_cosine|vector_dot|distance|similarity|cosine|euclidean|manhattan)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.other.gql",
          "match": "\\b(?i:all|any|none|single|coalesce|nullIf)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.gql",
          "match": "\\b(?i:INTEGER|FLOAT|STRING|BOOLEAN|DATE|TIME|DATETIME|DURATION|POINT|VECTOR|UUID|BYTES|JSON|LIST|MAP|NODE|RELATIONSHIP|PATH|GRAPH|ANY)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.gql",
          "match": "(=|<>|<|>|<=|>=|=~|!~)"
        },
        {
          "name": "keyword.operator.arithmetic.gql",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.concatenation.gql",
          "match": "\\|\\|"
        },
        {
          "name": "keyword.operator.arrow.gql",
          "match": "(->|<-|=>)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.parameter.gql",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.tag.label.gql",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
