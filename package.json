{
  "name": "geode-vscode",
  "displayName": "Geode for VS Code",
  "description": "Official VS Code extension for Geode graph database - GQL/Cypher syntax highlighting, LSP, query execution, and graph visualization",
  "version": "1.3.0",
  "publisher": "codeprosorg",
  "author": "CodePros",
  "icon": "images/geode-icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/devnw/codepros/geode/geode-vscode.git"
  },
  "homepage": "https://gitlab.com/devnw/codepros/geode",
  "bugs": {
    "url": "https://gitlab.com/devnw/codepros/geode/geode-vscode/-/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "gql",
    "cypher",
    "graph",
    "database",
    "query",
    "neo4j",
    "geode",
    "iso-gql"
  ],
  "activationEvents": [
    "onLanguage:gql",
    "onLanguage:cypher",
    "workspaceContains:**/*.gql",
    "workspaceContains:**/*.gcypher",
    "workspaceContains:**/*.pgql",
    "workspaceContains:**/*.cypher",
    "onCommand:geode.runQuery"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gql",
        "aliases": [
          "GQL",
          "Graph Query Language",
          "ISO GQL"
        ],
        "extensions": [
          ".gql",
          ".gcypher",
          ".pgql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/geode-icon.svg",
          "dark": "./images/geode-icon.svg"
        }
      },
      {
        "id": "cypher",
        "aliases": [
          "Cypher"
        ],
        "extensions": [
          ".cypher"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gql",
        "scopeName": "source.gql",
        "path": "./syntaxes/gql.tmLanguage.json"
      },
      {
        "language": "cypher",
        "scopeName": "source.gql",
        "path": "./syntaxes/gql.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gql",
        "path": "./snippets/gql.json"
      },
      {
        "language": "cypher",
        "path": "./snippets/gql.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "geode-explorer",
          "title": "Geode",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "geode-explorer": [
        {
          "type": "webview",
          "id": "geodeSidebar",
          "name": "Geode",
          "icon": "$(database)",
          "contextualTitle": "Geode"
        }
      ]
    },
    "commands": [
      {
        "command": "geode.runQuery",
        "title": "Run GQL Query",
        "category": "Geode",
        "icon": "$(play)"
      },
      {
        "command": "geode.runSelection",
        "title": "Run Selected Query",
        "category": "Geode",
        "icon": "$(play)"
      },
      {
        "command": "geode.formatDocument",
        "title": "Format GQL Document",
        "category": "Geode",
        "icon": "$(code)"
      },
      {
        "command": "geode.showDocumentation",
        "title": "Show GQL Documentation",
        "category": "Geode",
        "icon": "$(book)"
      },
      {
        "command": "geode.explainQuery",
        "title": "Explain Query Plan",
        "category": "Geode",
        "icon": "$(info)"
      },
      {
        "command": "geode.restartLsp",
        "title": "Restart Language Server",
        "category": "Geode",
        "icon": "$(refresh)"
      },
      {
        "command": "geode.runFile",
        "title": "Run GQL File",
        "category": "Geode",
        "icon": "$(play)"
      },
      {
        "command": "geode.refreshSchema",
        "title": "Refresh Schema",
        "category": "Geode",
        "icon": "$(refresh)"
      },
      {
        "command": "geode.showQueryPlan",
        "title": "Show Query Plan",
        "category": "Geode",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "geode.showAnalyticsDashboard",
        "title": "Show Analytics Dashboard",
        "category": "Geode",
        "icon": "$(graph)"
      },
      {
        "command": "geode.showPerformanceMetrics",
        "title": "Show Performance Metrics",
        "category": "Geode",
        "icon": "$(dashboard)"
      },
      {
        "command": "geode.showPathExplorer",
        "title": "Show Path Explorer",
        "category": "Geode",
        "icon": "$(git-compare)"
      },
      {
        "command": "geode.connections.add",
        "title": "Add Connection",
        "category": "Geode",
        "icon": "$(add)"
      },
      {
        "command": "geode.connections.edit",
        "title": "Edit Connection",
        "category": "Geode",
        "icon": "$(edit)"
      },
      {
        "command": "geode.connections.delete",
        "title": "Delete Connection",
        "category": "Geode",
        "icon": "$(trash)"
      },
      {
        "command": "geode.connections.connect",
        "title": "Connect",
        "category": "Geode",
        "icon": "$(plug)"
      },
      {
        "command": "geode.connections.disconnect",
        "title": "Disconnect",
        "category": "Geode",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "geode.connections.setDefault",
        "title": "Set as Default",
        "category": "Geode",
        "icon": "$(star)"
      },
      {
        "command": "geode.connections.copyDsn",
        "title": "Copy Connection String",
        "category": "Geode",
        "icon": "$(copy)"
      },
      {
        "command": "geode.connections.refresh",
        "title": "Refresh Connections",
        "category": "Geode",
        "icon": "$(refresh)"
      },
      {
        "command": "geode.history.insertQuery",
        "title": "Insert Query",
        "category": "Geode",
        "icon": "$(insert)"
      },
      {
        "command": "geode.history.copyQuery",
        "title": "Copy Query",
        "category": "Geode",
        "icon": "$(copy)"
      },
      {
        "command": "geode.history.rerunQuery",
        "title": "Run Again",
        "category": "Geode",
        "icon": "$(play)"
      },
      {
        "command": "geode.history.removeEntry",
        "title": "Remove from History",
        "category": "Geode",
        "icon": "$(trash)"
      },
      {
        "command": "geode.history.clear",
        "title": "Clear Query History",
        "category": "Geode",
        "icon": "$(clear-all)"
      },
      {
        "command": "geode.history.refresh",
        "title": "Refresh History",
        "category": "Geode",
        "icon": "$(refresh)"
      },
      {
        "command": "geode.savedQueries.save",
        "title": "Save Query",
        "category": "Geode",
        "icon": "$(save)"
      },
      {
        "command": "geode.savedQueries.open",
        "title": "Open Query",
        "category": "Geode",
        "icon": "$(go-to-file)"
      },
      {
        "command": "geode.savedQueries.edit",
        "title": "Edit Query",
        "category": "Geode",
        "icon": "$(edit)"
      },
      {
        "command": "geode.savedQueries.delete",
        "title": "Delete Query",
        "category": "Geode",
        "icon": "$(trash)"
      },
      {
        "command": "geode.savedQueries.run",
        "title": "Run Query",
        "category": "Geode",
        "icon": "$(play)"
      },
      {
        "command": "geode.savedQueries.copy",
        "title": "Copy Query",
        "category": "Geode",
        "icon": "$(copy)"
      },
      {
        "command": "geode.savedQueries.refresh",
        "title": "Refresh Saved Queries",
        "category": "Geode",
        "icon": "$(refresh)"
      },
      {
        "command": "geode.savedQueries.exportAll",
        "title": "Export All Queries",
        "category": "Geode",
        "icon": "$(export)"
      },
      {
        "command": "geode.savedQueries.importAll",
        "title": "Import Queries",
        "category": "Geode",
        "icon": "$(import)"
      },
      {
        "command": "geode.mcp.listTools",
        "title": "List MCP Tools",
        "category": "Geode",
        "icon": "$(list-flat)"
      },
      {
        "command": "geode.mcp.executeTool",
        "title": "Execute MCP Tool",
        "category": "Geode",
        "icon": "$(play)"
      },
      {
        "command": "geode.showGraphVisualization",
        "title": "Show Graph Visualization",
        "category": "Geode",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "geode.visualizeQuery",
        "title": "Visualize Query as Graph",
        "category": "Geode",
        "icon": "$(graph)"
      },
      {
        "command": "geode.showSpaShell",
        "title": "Show Geode UI (SPA Shell)",
        "category": "Geode",
        "icon": "$(window)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "geode.runQuery",
          "when": "resourceLangId == gql || resourceLangId == cypher",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "geode.runFile",
          "when": "resourceLangId == gql || resourceLangId == cypher",
          "group": "1_run@1"
        },
        {
          "command": "geode.runSelection",
          "when": "resourceLangId == gql || resourceLangId == cypher && editorHasSelection",
          "group": "1_run@2"
        },
        {
          "command": "geode.explainQuery",
          "when": "resourceLangId == gql || resourceLangId == cypher",
          "group": "1_run@3"
        },
        {
          "command": "geode.visualizeQuery",
          "when": "resourceLangId == gql || resourceLangId == cypher",
          "group": "1_run@4"
        }
      ],
      "commandPalette": [
        {
          "command": "geode.runQuery",
          "when": "resourceLangId == gql || resourceLangId == cypher"
        },
        {
          "command": "geode.runSelection",
          "when": "resourceLangId == gql || resourceLangId == cypher && editorHasSelection"
        },
        {
          "command": "geode.runFile",
          "when": "resourceLangId == gql || resourceLangId == cypher"
        },
        {
          "command": "geode.connections.add"
        },
        {
          "command": "geode.connections.disconnect",
          "when": "geode.hasActiveConnection"
        }
      ],
      "explorer/context": [
        {
          "command": "geode.runFile",
          "when": "resourceExtname == .gql || resourceExtname == .gcypher || resourceExtname == .pgql || resourceExtname == .cypher",
          "group": "navigation"
        }
      ],
      "view/title": [],
      "view/item/context": []
    },
    "keybindings": [
      {
        "command": "geode.runFile",
        "key": "f5",
        "when": "editorTextFocus && (editorLangId == gql || editorLangId == cypher)"
      },
      {
        "command": "geode.runFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == gql || editorLangId == cypher)"
      },
      {
        "command": "geode.runSelection",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorHasSelection && (editorLangId == gql || editorLangId == cypher)"
      },
      {
        "command": "geode.formatDocument",
        "key": "shift+alt+f",
        "when": "editorTextFocus && (editorLangId == gql || editorLangId == cypher)"
      },
      {
        "command": "geode.savedQueries.save",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus && (editorLangId == gql || editorLangId == cypher)"
      },
      {
        "command": "geode.visualizeQuery",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus && (editorLangId == gql || editorLangId == cypher)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Geode GQL",
      "properties": {
        "geode.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Geode Language Server"
        },
        "geode.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "geode.bundledServer.startupTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "Milliseconds to wait for the bundled geode-ui server to log its LISTENING line before failing activation."
        },
        "geode.bundledServer.logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "Log level passed to the bundled geode-ui server."
        },
        "geode.query.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Query execution timeout in milliseconds"
        },
        "geode.query.maxResults": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of results to display"
        },
        "geode.format.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces for indentation"
        },
        "geode.format.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "Case for GQL keywords"
        },
        "geode.format.foldPropertyMaps": {
          "type": "boolean",
          "default": true,
          "description": "Fold property maps with multiple properties onto separate lines for better readability"
        },
        "geode.format.maxLineLength": {
          "type": "number",
          "default": 80,
          "description": "Maximum line length before folding property maps (when fold is enabled)"
        },
        "geode.format.minPropertiesToFold": {
          "type": "number",
          "default": 2,
          "description": "Minimum number of properties before folding property maps"
        }
      }
    },
    "configurationDefaults": {
      "[gql]": {
        "editor.defaultFormatter": "geodedb.geode-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      },
      "[cypher]": {
        "editor.defaultFormatter": "geodedb.geode-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "prebuild:webview": "mkdir -p out/webview && cp src/webview/adapter.template.js out/webview/",
    "compile": "npm run prebuild:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "mocha 'out/test/**/*.test.js' --timeout 30000",
    "test:unit": "mocha 'out/test/**/*.test.js' --grep 'Unit Tests' --timeout 30000",
    "compile:e2e": "tsc -p e2e/ && mkdir -p out/e2e/fixtures && cp -r e2e/fixtures/. out/e2e/fixtures/",
    "test:e2e": "npm run prepackage && npm run compile:e2e && node out/e2e/runTest.js",
    "test:integration": "mocha 'out/test/**/*.integration.test.js' --timeout 60000",
    "test:coverage": "c8 --reporter=text --reporter=lcov mocha 'out/test/**/*.test.js' --timeout 30000",
    "package": "vsce package --skip-license",
    "publish": "vsce publish",
    "fetch:ui": "node scripts/fetch-geode-ui.mjs",
    "fetch:ui:local": "node scripts/fetch-geode-ui.mjs --source=local --path=../geode-ui",
    "fetch:bin:local": "node scripts/fetch-geode-binaries.mjs --source=local",
    "prepackage": "npm run fetch:ui:local && npm run fetch:bin:local && node scripts/collect-bundled-licenses.mjs && npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-ws-jsonrpc": "^3.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "mocha": "^11.3.0",
    "tar": "^7.5.15",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5"
  }
}
